@page
@model OnlineCourseManagementPortal.Pages.Enrollments.IndexModel
@{
    ViewData["Title"] = "Enrollments";
}

<!-- Add this if you're not sure CSS is loading -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-clipboard-list"></i> Enrollments</h1>
    <a asp-page="Create" class="btn btn-info">
        <i class="fas fa-plus"></i> New Enrollment
    </a>
</div>

@if (Model.Enrollments.Any())
{
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Student</th>
                <th>Course</th>
                <th>Instructor</th>
                <th>Enrollment Date</th>
                <th>Status</th>
                <th>Grade</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enrollment in Model.Enrollments)
                {
            <tr>
                <td>@enrollment.Id</td>
                <td>@enrollment.Student?.FullName</td>
                <td>@enrollment.Course?.Title</td>
                <td>@enrollment.Course?.Instructor?.FullName</td>
                <td>@enrollment.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                <td>
                    @switch (enrollment.Status)
                            {
                                case EnrollmentStatus.Active:
                    <span class="badge bg-success">Active</span>
                                    break;
                                case EnrollmentStatus.Completed:
                    <span class="badge bg-primary">Completed</span>
                                    break;
                                case EnrollmentStatus.Dropped:
                    <span class="badge bg-warning">Dropped</span>
                                    break;
                                case EnrollmentStatus.Failed:
                    <span class="badge bg-danger">Failed</span>
                                    break;
                            }
                </td>
                <td>
                    @if (!string.IsNullOrEmpty(enrollment.Grade))
                            {
                    <span class="badge bg-secondary">@enrollment.Grade</span>
                            }
                            else
                            {
                    <span class="text-muted">-</span>
                            }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@enrollment.Id" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@enrollment.Id" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-page="./Delete" asp-route-id="@enrollment.Id" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
                }
        </tbody>
    </table>
</div>
}
else
{
<div class="alert alert-info">
    <i class="fas fa-info-circle"></i> No enrollments found. Create your first enrollment!
</div>
}