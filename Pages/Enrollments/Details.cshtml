@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Enrollments.DetailsModel
@{
    ViewData["Title"] = "Enrollment Details";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Enrollment Information</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Enrollment ID:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Id</dd>

                    <dt class="col-sm-4">Student:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Student?.FullName</dd>

                    <dt class="col-sm-4">Course:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Course?.Title</dd>

                    <dt class="col-sm-4">Instructor:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Course?.Instructor?.FullName</dd>

                    <dt class="col-sm-4">Enrollment Date:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.EnrollmentDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Enrollment.Status)
                        {
                            case EnrollmentStatus.Active:
                        <span class="badge bg-success">Active</span>
                                break;
                            case EnrollmentStatus.Completed:
                        <span class="badge bg-primary">Completed</span>
                                break;
                            case EnrollmentStatus.Dropped:
                        <span class="badge bg-warning">Dropped</span>
                                break;
                            case EnrollmentStatus.Failed:
                        <span class="badge bg-danger">Failed</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Grade:</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Enrollment.Grade))
                        {
                        <span class="badge bg-secondary fs-6">@Model.Enrollment.Grade</span>
                        }
                        else
                        {
                        <span class="text-muted">Not graded yet</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-page="./Edit" asp-route-id="@Model.Enrollment.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>
</div>