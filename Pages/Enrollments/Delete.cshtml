@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Enrollments.DeleteModel
@{
    ViewData["Title"] = "Delete Enrollment";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3><i class="fas fa-trash"></i> Delete Enrollment</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5>Are you sure you want to delete this enrollment?</h5>
                    <p class="mb-0">This action cannot be undone.</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Student:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Student?.FullName</dd>

                    <dt class="col-sm-4">Course:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.Course?.Title</dd>

                    <dt class="col-sm-4">Enrollment Date:</dt>
                    <dd class="col-sm-8">@Model.Enrollment.EnrollmentDate.ToString("MMM dd, yyyy")</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Enrollment.Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="./Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete Enrollment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>