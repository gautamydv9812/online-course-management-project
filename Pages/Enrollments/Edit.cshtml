@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Enrollments.EditModel
@{
    ViewData["Title"] = "Edit Enrollment";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-edit"></i> Edit Enrollment</h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Enrollment.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Enrollment.StudentId" class="form-label">Student *</label>
                            <select asp-for="Enrollment.StudentId" asp-items="Model.Students" class="form-control">
                                <option value="">-- Select Student --</option>
                            </select>
                            <span asp-validation-for="Enrollment.StudentId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Enrollment.CourseId" class="form-label">Course *</label>
                            <select asp-for="Enrollment.CourseId" asp-items="Model.Courses" class="form-control">
                                <option value="">-- Select Course --</option>
                            </select>
                            <span asp-validation-for="Enrollment.CourseId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Enrollment.EnrollmentDate" class="form-label">Enrollment Date *</label>
                            <input asp-for="Enrollment.EnrollmentDate" type="date" class="form-control" />
                            <span asp-validation-for="Enrollment.EnrollmentDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Enrollment.Status" class="form-label">Status *</label>
                            <select asp-for="Enrollment.Status" class="form-control">
                                <option value="0">Active</option>
                                <option value="1">Completed</option>
                                <option value="2">Dropped</option>
                                <option value="3">Failed</option>
                            </select>
                            <span asp-validation-for="Enrollment.Status" class="text-danger"></span>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label asp-for="Enrollment.Grade" class="form-label">Grade</label>
                            <select asp-for="Enrollment.Grade" class="form-control">
                                <option value="">-- Select Grade --</option>
                                <option value="A+">A+</option>
                                <option value="A">A</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B">B</option>
                                <option value="B-">B-</option>
                                <option value="C+">C+</option>
                                <option value="C">C</option>
                                <option value="D">D</option>
                                <option value="F">F</option>
                            </select>
                            <span asp-validation-for="Enrollment.Grade" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-info">Update Enrollment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}