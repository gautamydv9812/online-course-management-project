@page
@model OnlineCourseManagementPortal.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<!-- Add Bootstrap CDN if not already in layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-user-graduate"></i> Students</h1>
    <a asp-page="Create" class="btn btn-success">
        <i class="fas fa-plus"></i> Add New Student
    </a>
</div>

@if (Model.Students.Any())
{
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-primary" style="background-color: #007bff; color: white;">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Enrollment Date</th>
                <th>Courses</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
                {
            <tr>
                <td><strong>@student.Id</strong></td>
                <td>@student.FullName</td>
                <td>@student.Email</td>
                <td>@student.Phone</td>
                <td>@student.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                <td>
                    <span class="badge bg-info">@student.Enrollments.Count</span>
                </td>
                <td>
                    @if (student.IsActive)
                            {
                    <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                    <span class="badge bg-danger">Inactive</span>
                            }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@student.Id" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@student.Id" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-page="./Delete" asp-route-id="@student.Id" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
                }
        </tbody>
    </table>
</div>
}
else
{
<div class="alert alert-info">
    <i class="fas fa-info-circle"></i> No students found. Register your first student!
</div>
}