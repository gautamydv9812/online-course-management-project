@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Students.EditModel
@{
    ViewData["Title"] = "Edit Student";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-edit"></i> Edit Student</h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Student.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.FirstName" class="form-label">First Name *</label>
                            <input asp-for="Student.FirstName" class="form-control" />
                            <span asp-validation-for="Student.FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.LastName" class="form-label">Last Name *</label>
                            <input asp-for="Student.LastName" class="form-control" />
                            <span asp-validation-for="Student.LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.Email" class="form-label">Email *</label>
                            <input asp-for="Student.Email" type="email" class="form-control" />
                            <span asp-validation-for="Student.Email" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.Phone" class="form-label">Phone *</label>
                            <input asp-for="Student.Phone" class="form-control" />
                            <span asp-validation-for="Student.Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.DateOfBirth" class="form-label">Date of Birth *</label>
                            <input asp-for="Student.DateOfBirth" type="date" class="form-control" />
                            <span asp-validation-for="Student.DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Student.EnrollmentDate" class="form-label">Enrollment Date *</label>
                            <input asp-for="Student.EnrollmentDate" type="date" class="form-control" />
                            <span asp-validation-for="Student.EnrollmentDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="Student.Address" class="form-label">Address</label>
                            <input asp-for="Student.Address" class="form-control" />
                            <span asp-validation-for="Student.Address" class="text-danger"></span>
                        </div>

                        <div class="col-md-2 mb-3">
                            <label asp-for="Student.City" class="form-label">City</label>
                            <input asp-for="Student.City" class="form-control" />
                            <span asp-validation-for="Student.City" class="text-danger"></span>
                        </div>

                        <div class="col-md-2 mb-3">
                            <label asp-for="Student.Country" class="form-label">Country</label>
                            <input asp-for="Student.Country" class="form-control" />
                            <span asp-validation-for="Student.Country" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Student.IsActive" class="form-check-input" />
                        <label asp-for="Student.IsActive" class="form-check-label">Active Student</label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-success">Update Student</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}