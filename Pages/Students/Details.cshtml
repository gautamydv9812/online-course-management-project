@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Students.DetailsModel
@{
    ViewData["Title"] = "Student Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h3><i class="fas fa-user-circle"></i> Student Information</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Student ID:</dt>
                    <dd class="col-sm-8">@Model.Student.Id</dd>

                    <dt class="col-sm-4">Full Name:</dt>
                    <dd class="col-sm-8">@Model.Student.FullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Student.Email</dd>

                    <dt class="col-sm-4">Phone:</dt>
                    <dd class="col-sm-8">@Model.Student.Phone</dd>

                    <dt class="col-sm-4">Date of Birth:</dt>
                    <dd class="col-sm-8">@Model.Student.DateOfBirth.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Enrollment Date:</dt>
                    <dd class="col-sm-8">@Model.Student.EnrollmentDate.ToString("MMM dd, yyyy")</dd>

                    <dt class="col-sm-4">Address:</dt>
                    <dd class="col-sm-8">@Model.Student.Address, @Model.Student.City, @Model.Student.Country</dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Student.IsActive)
                        {
                        <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                        <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-page="./Edit" asp-route-id="@Model.Student.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-book"></i> Enrolled Courses (@Model.Enrollments.Count)</h5>
            </div>
            <div class="card-body">
                @if (Model.Enrollments.Any())
                {
                <ul class="list-group list-group-flush">
                    @foreach (var enrollment in Model.Enrollments)
                        {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@enrollment.Course?.Title</strong><br>
                            <small class="text-muted">@enrollment.Course?.Instructor?.FullName</small>
                        </div>
                        <span class="badge bg-primary rounded-pill">@enrollment.Grade</span>
                    </li>
                        }
                </ul>
                }
                else
                {
                <p class="text-muted">No courses enrolled yet.</p>
                }
            </div>
        </div>
    </div>
</div>