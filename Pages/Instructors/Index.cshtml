@page
@model OnlineCourseManagementPortal.Pages.Instructors.IndexModel
@{
    ViewData["Title"] = "Instructors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-chalkboard-teacher"></i> Instructors</h1>
    <a asp-page="Create" class="btn btn-warning">
        <i class="fas fa-plus"></i> Add New Instructor
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Specialization</th>
                <th>Hire Date</th>
                <th>Courses</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var instructor in Model.Instructors)
            {
            <tr>
                <td>@instructor.Id</td>
                <td>@instructor.FullName</td>
                <td>@instructor.Email</td>
                <td>@instructor.Phone</td>
                <td>@instructor.Specialization</td>
                <td>@instructor.HireDate.ToString("MMM dd, yyyy")</td>
                <td>
                    <span class="badge bg-primary">@instructor.TotalCourses</span>
                </td>
                <td>
                    @if (instructor.IsActive)
                        {
                    <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                    <span class="badge bg-danger">Inactive</span>
                        }
                </td>
                <td>
                    <a asp-page="./Details" asp-route-id="@instructor.Id" class="btn btn-info btn-sm">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a asp-page="./Edit" asp-route-id="@instructor.Id" class="btn btn-warning btn-sm">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-page="./Delete" asp-route-id="@instructor.Id" class="btn btn-danger btn-sm">
                        <i class="fas fa-trash"></i>
                    </a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Instructors.Any())
{
<div class="alert alert-info">
    <i class="fas fa-info-circle"></i> No instructors found. Add your first instructor!
</div>
}
