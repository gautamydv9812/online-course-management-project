@page
@model CreateModel

<h2>Add Instructor</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Instructor.FirstName"></label>
        <input asp-for="Instructor.FirstName" class="form-control" />
        <span asp-validation-for="Instructor.FirstName"></span>
    </div>

    <div class="form-group">
        <label asp-for="Instructor.LastName"></label>
        <input asp-for="Instructor.LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.Email"></label>
        <input asp-for="Instructor.Email" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.Phone"></label>
        <input asp-for="Instructor.Phone" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.DateOfBirth"></label>
        <input asp-for="Instructor.DateOfBirth" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.HireDate"></label>
        <input asp-for="Instructor.HireDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.Specialization"></label>
        <input asp-for="Instructor.Specialization" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Instructor.Salary"></label>
        <input asp-for="Instructor.Salary" class="form-control" />
    </div>

    <div class="form-group">
        <input asp-for="Instructor.IsActive" /> Active
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>
