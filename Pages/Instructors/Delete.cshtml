@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Instructors.DeleteModel

@{
    ViewData["Title"] = "Delete Instructor";
}

<h2>Delete Instructor</h2>
<hr />

<h4>Are you sure you want to delete this instructor?</h4>

<div class="alert alert-danger">
    <strong>@Model.Instructor.FullName</strong><br />
    Email: @Model.Instructor.Email
</div>

<form method="post">
    <input type="hidden" asp-for="Instructor.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
