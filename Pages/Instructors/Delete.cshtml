@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Instructors.DeleteModel
@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3><i class="fas fa-trash"></i> Delete Instructor</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5>Are you sure you want to delete this instructor?</h5>
                    <p class="mb-0">Courses assigned to this instructor will need to be reassigned.</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Name:</dt>
                    <dd class="col-sm-8">@Model.Instructor.FullName</dd>

                    <dt class="col-sm-4">Email:</dt>
                    <dd class="col-sm-8">@Model.Instructor.Email</dd>

                    <dt class="col-sm-4">Specialization:</dt>
                    <dd class="col-sm-8">@Model.Instructor.Specialization</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Instructor.Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="./Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete Instructor</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
