@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Courses.DeleteModel
@{
    ViewData["Title"] = "Delete Course";
}

<div class="row">
    <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header bg-danger text-white">
                <h3><i class="fas fa-trash"></i> Delete Course</h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h5>Are you sure you want to delete this course?</h5>
                    <p class="mb-0">This action cannot be undone.</p>
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Course Code:</dt>
                    <dd class="col-sm-8">@Model.Course.Code</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8">@Model.Course.Title</dd>

                    <dt class="col-sm-4">Instructor:</dt>
                    <dd class="col-sm-8">@(Model.Course.Instructor?.FullName ?? "N/A")</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Course.Id" />
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="./Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-danger">Delete Course</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>