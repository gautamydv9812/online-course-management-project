@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Courses.EditModel
@{
    ViewData["Title"] = "Edit Course";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-edit"></i> Edit Course</h3>
            </div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Course.Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Course.Code" class="form-label">Course Code *</label>
                            <input asp-for="Course.Code" class="form-control" />
                            <span asp-validation-for="Course.Code" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Course.Title" class="form-label">Course Title *</label>
                            <input asp-for="Course.Title" class="form-control" />
                            <span asp-validation-for="Course.Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Course.Description" class="form-label">Description</label>
                        <textarea asp-for="Course.Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Course.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Course.CreditHours" class="form-label">Credit Hours *</label>
                            <input asp-for="Course.CreditHours" class="form-control" />
                            <span asp-validation-for="Course.CreditHours" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Course.Price" class="form-label">Price *</label>
                            <input asp-for="Course.Price" class="form-control" />
                            <span asp-validation-for="Course.Price" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 mb-3">
                            <label asp-for="Course.MaxStudents" class="form-label">Max Students *</label>
                            <input asp-for="Course.MaxStudents" class="form-control" />
                            <span asp-validation-for="Course.MaxStudents" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Course.StartDate" class="form-label">Start Date *</label>
                            <input asp-for="Course.StartDate" type="date" class="form-control" />
                            <span asp-validation-for="Course.StartDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Course.EndDate" class="form-label">End Date *</label>
                            <input asp-for="Course.EndDate" type="date" class="form-control" />
                            <span asp-validation-for="Course.EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Course.InstructorId" class="form-label">Instructor *</label>
                        <select asp-for="Course.InstructorId" asp-items="Model.Instructors" class="form-control">
                            <option value="">-- Select Instructor --</option>
                        </select>
                        <span asp-validation-for="Course.InstructorId" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="Course.IsActive" class="form-check-input" />
                        <label asp-for="Course.IsActive" class="form-check-label">Active Course</label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-page="Index" class="btn btn-secondary me-md-2">Cancel</a>
                        <button type="submit" class="btn btn-primary">Update Course</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}