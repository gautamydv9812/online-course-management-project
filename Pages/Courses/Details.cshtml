@page "{id:int}"
@model OnlineCourseManagementPortal.Pages.Courses.DetailsModel
@{
    ViewData["Title"] = "Course Details";
}

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Course Information</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Course Code:</dt>
                    <dd class="col-sm-8">@Model.Course.Code</dd>

                    <dt class="col-sm-4">Title:</dt>
                    <dd class="col-sm-8">@Model.Course.Title</dd>

                    <dt class="col-sm-4">Description:</dt>
                    <dd class="col-sm-8">@Model.Course.Description</dd>

                    <dt class="col-sm-4">Instructor:</dt>
                    <dd class="col-sm-8">@(Model.Course.Instructor?.FullName ?? "N/A")</dd>

                    <dt class="col-sm-4">Credit Hours:</dt>
                    <dd class="col-sm-8">@Model.Course.CreditHours</dd>

                    <dt class="col-sm-4">Price:</dt>
                    <dd class="col-sm-8">@Model.Course.Price.ToString("C")</dd>

                    <dt class="col-sm-4">Duration:</dt>
                    <dd class="col-sm-8">
                        @Model.Course.StartDate.ToString("MMM dd, yyyy") - @Model.Course.EndDate.ToString("MMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-4">Capacity:</dt>
                    <dd class="col-sm-8">
                        @Model.Course.CurrentStudents / @Model.Course.MaxStudents students
                        <div class="progress mt-1">
                            @{
                                var percentage = Model.Course.MaxStudents > 0 ?
                                    (Model.Course.CurrentStudents * 100) / Model.Course.MaxStudents : 0;
                            }
                            <div class="progress-bar" role="progressbar"
                                 style="width: @percentage%"></div>
                        </div>
                    </dd>

                    <dt class="col-sm-4">Status:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Course.IsActive)
                        {
                        <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                        <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer">
                <a asp-page="./Edit" asp-route-id="@Model.Course.Id" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Edit
                </a>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5><i class="fas fa-users"></i> Enrolled Students (@Model.Course.CurrentStudents)</h5>
            </div>
            <div class="card-body">
                @if (Model.Enrollments.Any())
                {
                <ul class="list-group list-group-flush">
                    @foreach (var enrollment in Model.Enrollments)
                        {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @(enrollment.Student?.FullName ?? "Unknown")
                        @if (!string.IsNullOrEmpty(enrollment.Grade))
                                {
                        <span class="badge bg-primary rounded-pill">@enrollment.Grade</span>
                                }
                    </li>
                        }
                </ul>
                }
                else
                {
                <p class="text-muted">No students enrolled yet.</p>
                }
            </div>
        </div>
    </div>
</div>