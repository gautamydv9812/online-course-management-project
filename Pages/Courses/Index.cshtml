@page
@model OnlineCourseManagementPortal.Pages.Courses.IndexModel
@{
    ViewData["Title"] = "Courses";
}

<!-- Add Bootstrap CDN if not already in layout -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fas fa-book"></i> Courses</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add New Course
    </a>
</div>

@if (Model.Courses.Any())
{
<div class="table-responsive">
    <table class="table table-striped table-hover table-bordered">
        <thead class="table-primary" style="background-color: #007bff; color: white;">
            <tr>
                <th>Code</th>
                <th>Title</th>
                <th>Instructor</th>
                <th>Credits</th>
                <th>Price</th>
                <th>Start Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in Model.Courses)
                {
            <tr>
                <td><strong>@course.Code</strong></td>
                <td>@course.Title</td>
                <td>@(course.Instructor?.FullName ?? "N/A")</td>
                <td>@course.CreditHours</td>
                <td>@course.Price.ToString("C")</td>
                <td>@course.StartDate.ToString("MMM dd, yyyy")</td>
                <td>
                    @if (course.IsActive)
                            {
                    <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                    <span class="badge bg-danger">Inactive</span>
                            }
                </td>
                <td>
                    <div class="btn-group" role="group">
                        <a asp-page="./Details" asp-route-id="@course.Id" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-page="./Edit" asp-route-id="@course.Id" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a asp-page="./Delete" asp-route-id="@course.Id" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </td>
            </tr>
                }
        </tbody>
    </table>
</div>
}
else
{
<div class="alert alert-info">
    <i class="fas fa-info-circle"></i> No courses found. Add your first course!
</div>
}